{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "autoupdate": true,
  "server": {
    "port": 4096
  },
  "permission": {
    "skill": {
      "current-docs-coding": "allow"
    },
    "websearch": "allow",
    "webfetch": "allow",
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "npm test *": "allow",
      "npm run test *": "allow",
      "npm run lint *": "allow",
      "npm run build *": "allow",
      "npx tsc *": "allow",
      "git reset --hard *": "deny",
      "git clean -fd *": "deny",
      "git push --force*": "deny"
    }
  }
}